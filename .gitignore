# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Secrets — ignore real env files, but keep the committed templates in env/example/
.env
*.env
!*.example.env
!env/example/*.env
infra/rabbitmq/definitions.json
infra/redis/redis.conf
.codex

# Build outputs
services/backend/main

# The template ships without go.sum — its absence is the CI "unbootstrapped"
# gate signal (see .github/workflows/ci.yml / .gitlab-ci.yml). bootstrap.sh
# removes this ignore so the fork can run `go mod tidy` and commit the sum.
services/backend/go.sum

# Editor/IDE
.idea/
.vscode/
tmp/
node_modules/
dist/
